graph TB
    subgraph "Monitor masofasini sozlash"
        EYE["Foydalanuvchi ko'zi"]
        DIST1["50-70 sm masofa"]
        TOP["Monitor yuqori chetining ko'z bilan teng yoki biroz pastroq"]
        ANGLE["Pastga 15-20° burilish<br/>(boylin uchun qulay)"]
        MID["Monitor markazi —<br/>ko'zdan 10-20 sm pastroq"]
        TILT["Monitor 5-15°<br/>orqaga egilgan"]
    end

    subgraph "Tavsiya etilgan parametrlar"
        SZ["O'lcham: 24-27 dyuym<br/>(60-68 sm) optimal"]
        RES["Rezolyutsiya: 1920×1080+<br/>(retina-darajada)"]
        REF["Yangilanish: 60+ Hz<br/>(LCD uchun yetarli)"]
        BR["Yorqinlik: xona yoritilishiga teng"]
    end

    EYE --> DIST1
    DIST1 --> TOP
    DIST1 --> MID
    TOP --> ANGLE
    MID --> ANGLE
    ANGLE --> TILT

    SZ -.-> DIST1
    RES -.-> SZ
    REF -.-> SZ
    BR -.-> EYE

    classDef pos fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef param fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e

    class EYE,DIST1,TOP,ANGLE,MID,TILT pos
    class SZ,RES,REF,BR param
