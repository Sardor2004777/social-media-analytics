    H["Increment<br/>Production-ready<br/>versiya"] -.-> F
    F --> H

    classDef plan fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef do fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef review fill:#fce7f3,stroke:#db2777,color:#831843
    classDef done fill:#dcfce7,stroke:#16a34a,color:#14532d

    class A,B,C plan
    class D,E do
    class F,G review
    class H done
